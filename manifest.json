{
  "manifest_version": 3,
  "name": "Substack Context Capture",
  "version": "0.1.2",
  "description": "Lưu bài viết Substack và các nhánh thảo luận đã chọn thành gói nghiên cứu có cấu trúc.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://substack.com/*",
    "https://*.substack.com/*",
    "https://*.substackcdn.com/*",
    "https://substack-post-media.s3.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mở Substack Context Capture"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://substack.com/*",
        "https://*.substack.com/*"
      ],
      "js": [
        "content.js",
        "content-comments.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
